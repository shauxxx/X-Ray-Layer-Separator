#!/usr/bin/env python3
"""
Shift-and-Add реконструкция с использованием ВСЕХ кадров.
"""

IMAGE_EXTS = {".png", ".tif", ".tiff", ".bmp", ".jpg", ".jpeg"}

import configparser
import math
import re
from pathlib import Path

import cv2
import numpy as np


def read_log(path: Path):
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with path.open("r", encoding="utf-8-sig") as f:
        cfg.read_file(f)
    return cfg


def get_float(cfg, section, key, default):
    try:
        val = cfg[section][key].strip()
        return float(val) if val else float(default)
    except:
        return float(default)


def natural_key(path: Path):
    return [int(s) if s.isdigit() else s.lower() for s in re.split(r"(\d+)", path.name)]


def load_grayscale(path: Path):
    image = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)
    if image is None:
        raise RuntimeError(f"Не удалось прочитать: {path}")
    if image.ndim == 3:
        image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY if image.shape[2] == 3 else cv2.COLOR_BGRA2GRAY)
    return image


def normalize_image(image):
    a = image.astype(np.float32)
    lo, hi = np.percentile(a, [1.0, 99.0])
    if hi <= lo:
        hi = lo + 1.0
    return np.clip((a - lo) / (hi - lo), 0.0, 1.0)


def shift_image(image, dx, dy):
    """Сдвиг изображения на dx, dy пикселей."""
    h, w = image.shape
    M = np.float32([[1, 0, dx], [0, 1, dy]])
    return cv2.warpAffine(image, M, (w, h), flags=cv2.INTER_CUBIC, borderMode=cv2.BORDER_CONSTANT, borderValue=0)


def compute_shift(z_mm, angle_deg, sod, sdd, pixel_size_mm):
    """
    Вычисление сдвига для слоя на глубине z при угле angle.
    
    Формула из подобия треугольников:
    shift = z * sin(θ) * (SDD - SOD) / SOD / pixel_size
    """
    angle_rad = math.radians(angle_deg)
    obj_to_det = sdd - sod
    shift_mm = z_mm * math.sin(angle_rad) * obj_to_det / sod
    shift_px = shift_mm / pixel_size_mm
    return shift_px


def reconstruct_layer(frames, angles, z_mm, sod, sdd, pixel_size_mm):
    """
    Реконструкция одного слоя методом Shift-and-Add.
    
    Для каждого кадра:
    1. Вычисляем сдвиг для слоя на глубине z
    2. Сдвигаем кадр обратно (компенсируем)
    3. Складываем все компенсированные кадры
    4. Усредняем
    """
    h, w = frames[0].shape
    acc = np.zeros((h, w), dtype=np.float64)
    
    print(f"Реконструкция слоя на глубине z={z_mm:+.3f}мм...")
    
    for i, (frame, angle) in enumerate(zip(frames, angles)):
        # Вычисляем сдвиг для этого кадра
        shift_px = compute_shift(z_mm, angle, sod, sdd, pixel_size_mm)
        
        # Компенсируем сдвиг - сдвигаем кадр обратно
        compensated = shift_image(frame, -shift_px, 0)
        
        # Добавляем к аккумулятору
        acc += compensated
        
        if i % 5 == 0:
            print(f"  Кадр {i}: угол={angle:.1f}°, сдвиг={shift_px:.2f}px")
    
    # Усредняем
    result = acc / len(frames)
    return result


def enhance_image(image):
    img = np.clip(image * 255.0, 0, 255).astype(np.uint8)
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(16, 16))
    enhanced = clahe.apply(img)
    enhanced = cv2.fastNlMeansDenoising(enhanced, None, h=4, templateWindowSize=7, searchWindowSize=21)
    blurred = cv2.GaussianBlur(enhanced, (0, 0), 1.5)
    sharpened = cv2.addWeighted(enhanced, 1.8, blurred, -0.8, 0)
    return sharpened


def main():
    input_folder = Path("photo_for_test1")
    log_file = Path("photo_for_test1/s.log")
    output_folder = Path("reconstructed_layers")
    
    # Глубина слоя (половина толщины платы)
    z_mm = 5  # мм
    
    cfg = read_log(log_file)
    
    sod = get_float(cfg, "Acquisition", "Object to Source (mm)", 106.041)
    sdd = get_float(cfg, "Acquisition", "Camera to Source (mm)", 237.6)
    pixel_um = get_float(cfg, "Acquisition", "Scaled Image Pixel Size (um)", 137.584)
    pixel_size_mm = pixel_um / 1000.0
    start_angle = get_float(cfg, "GeometryCorrection", "Angle", 0.0)
    direction = cfg.get("Acquisition", "Rotation Direction", fallback="CW").strip().upper()
    
    files = sorted((p for p in input_folder.iterdir() if p.suffix.lower() in IMAGE_EXTS), key=natural_key)
    raw_frames = [load_grayscale(p) for p in files]
    frames = [normalize_image(im) for im in raw_frames]
    
    n = len(frames)
    print(f"Всего кадров: {n}")
    print(f"Геометрия: SOD={sod}мм, SDD={sdd}мм, pixel={pixel_size_mm*1000:.3f}мкм")
    print(f"Расстояние объект-детектор: {sdd - sod:.3f}мм")
    
    # Вычисляем углы для всех кадров
    sign = 1.0 if direction == "CW" else -1.0
    angles = [start_angle + sign * i * (360.0 / n) for i in range(n)]
    
    print(f"\nУглы: от {angles[0]:.1f}° до {angles[-1]:.1f}°")
    print(f"Максимальный сдвиг для z={z_mm}мм: {compute_shift(z_mm, 90, sod, sdd, pixel_size_mm):.2f}px")
    
    output_folder.mkdir(parents=True, exist_ok=True)
    
    # Реконструкция двух слоёв
    layer_top = reconstruct_layer(frames, angles, -z_mm, sod, sdd, pixel_size_mm)
    layer_bottom = reconstruct_layer(frames, angles, +z_mm, sod, sdd, pixel_size_mm)
    
    # Сохранение
    for layer, label in [(layer_top, "layer_top"), (layer_bottom, "layer_bottom")]:
        layer = np.clip(layer, 0.0, 1.0)
        cv2.imwrite(str(output_folder / f"{label}_16bit.png"), 
                    np.round(layer * 65535.0).astype(np.uint16))
        enhanced = enhance_image(layer)
        cv2.imwrite(str(output_folder / f"{label}_enhanced.png"), enhanced)
    
    print(f"\nГотово. Результаты в: {output_folder.resolve()}")


if __name__ == "__main__":
    main()